# ── Database ──────────────────────────────────────────────────────────────────
# Use container name (infra-postgres) when cortexmap-be runs on the same
# infra-net bridge. Use a public IP only when connecting from outside Docker.
DATABASE_URL=postgres://cortexmap:cortexmap_dev@infra-postgres:5432/cortexmap

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
# Use container name (infra-minio) when on the same infra-net bridge.
S3_ENDPOINT=http://infra-minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cortexmap

# ── HTTP Server ───────────────────────────────────────────────────────────────
FETCHER_HTTP_ADDR=0.0.0.0:8080
